{
  "_meta": {
    "project": "ActionGuardian",
    "scoring_version": "2.0",
    "note": "Config plus 21 real-world scenarios with computed expected scores. Content weights of newer detectors are proposals; calibrate on your own test set."
  },
  "config": {
    "version": "2.0",
    "tiers": [
      {
        "name": "SAFE",
        "min": 0,
        "max": 39,
        "popup": false,
        "dispatch": "auto",
        "note": "No popup. Silent log plus a 10 second Undo send."
      },
      {
        "name": "MEDIUM",
        "min": 40,
        "max": 59,
        "popup": true,
        "dispatch": "one_click_confirm",
        "note": "Small popup with the 3 questions. Send anyway or Improve."
      },
      {
        "name": "HIGH",
        "min": 60,
        "max": 79,
        "popup": true,
        "dispatch": "checkbox_confirm",
        "note": "Popup, rewrite suggested, confirmation checkbox required."
      },
      {
        "name": "CRITICAL",
        "min": 80,
        "max": 100,
        "popup": true,
        "dispatch": "blocked",
        "note": "Hard block. Rewrite or fix required."
      }
    ],
    "undo_window_seconds": 10,
    "hard_floor_score": 80,
    "hard_floor_triggers": [
      "secret_or_credential",
      "private_key",
      "violent_threat"
    ],
    "content_rules": {
      "secret_or_credential": 85,
      "private_key": 85,
      "pii_card_or_ssn": 60,
      "pii_hipaa": 60,
      "indian_id": 60,
      "abuse_mild": 15,
      "abuse_moderate": 35,
      "abuse_severe": 55,
      "abuse_violent": 70,
      "termination_or_legal_bonus": 10,
      "phishing_wire_pattern": 55,
      "mass_blast": 30,
      "external_confidential": 30,
      "salary_data": 20,
      "pricing_margins": 20,
      "insider_info": 30,
      "source_code": 30,
      "bulk_customer_data": 35,
      "bank_detail_change": 40,
      "urgency_secrecy": 20,
      "short_url": 15,
      "lookalike_url": 40,
      "risky_attachment": 40,
      "discriminatory": 60,
      "prompt_injection": 60,
      "liability_admission": 30,
      "unauthorized_promise": 20,
      "hallucination_marker": 10
    },
    "role_exception_content_multiplier": 0.5,
    "intent_points": {
      "routine": 0,
      "complaint": 5,
      "sensitive_info": 10,
      "data_transfer": 15,
      "hr_action": 15,
      "legal": 15,
      "money": 20
    },
    "intent_drift_points": 15,
    "backfire_factors": {
      "unknown_recipient": 1,
      "external_domain": 1,
      "lookalike_address": 2,
      "recipients_gt5": 1,
      "recipients_gt20": 2,
      "reply_all": 1,
      "ambiguous_tone": 1,
      "hostile_content": 2,
      "sensitive_attachment": 1,
      "prior_conflict": 1,
      "high_risk_recipient": 2
    },
    "backfire_bands": {
      "low": 0.2,
      "medium": 0.5,
      "high": 0.8
    },
    "backfire_band_rule": "factor count 0-1 = low, 2-3 = medium, 4+ = high",
    "impact_severity": {
      "security": 70,
      "legal": 60,
      "financial": 55,
      "reputation": 50,
      "hr": 45,
      "operational": 15
    },
    "scope_multiplier": {
      "one": 0.8,
      "group": 1.0,
      "org_public": 1.2
    },
    "irreversible_multiplier": 1.2,
    "impact_cap": 70,
    "formula": "risk = min(100, content + intent + round_half_up(backfire_p * impact)); then apply hard floor"
  },
